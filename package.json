{
  "name": "velm-lms-ui",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/test-runner.ts",
    "test:unit": "vitest run",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "express": "^5.2.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  }
}
