# Gemini API Key (optional, for academic workload analysis)
GEMINI_API_KEY=

# CORS Proxy Key (optional, server-side only if using an external proxy)
CORS_PROXY_KEY=

# Server-Side Test Canvas Credentials (optional, for running test suite)
TEST_CANVAS_DOMAIN=
TEST_CANVAS_TOKEN=

# StudentVUE / ParentVUE API Server URL (for Option A /api/studentvue Express reverse proxy)
# Local dev defaults to http://127.0.0.1:8080; in AI Studio / Cloud Run set to your Cloud Run URL:
SCHOOLVIEW_API_URL=
